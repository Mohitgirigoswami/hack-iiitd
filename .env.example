# KhetOS Environment Configuration Example
# Copy this file to .env and fill in your values

# 1. Google Gemini AI Studio API Key (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Token (From @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=True

# 4. Database Connection (Defaults to local SQLite for rapid hackathon testing)
# For PostgreSQL: postgresql://username:password@localhost:5432/khetos
DATABASE_URL=sqlite:///khetos.db

# 5. External APIs (Open-Meteo requires NO API key)

# 6. Razorpay Test Credentials (for Buyer Escrow Payment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
